#!/bin/bash
# commands/create_project — Scaffolding de projets Python/Django
# Usage: create_project [options] [project_name]

set -euo pipefail

# ========================
#   Source des librairies
# ========================
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
LIB_DIR="$(cd "$SCRIPT_DIR/../lib" && pwd)"

source "$LIB_DIR/common.sh"
source "$LIB_DIR/python.sh"
source "$LIB_DIR/git.sh"
source "$LIB_DIR/database.sh"

# ========================
#   Configuration par defaut
# ========================
load_config

CREATE_VENV=true
VENV_NAME="${CONFIG_DEFAULT_VENV_NAME:-.venv}"
INIT_GIT=true
CREATE_DJANGO=false
CREATE_FASTAPI=false
CREATE_FLASK=false
YES_MODE=false
PROJECT_NAME=""
CURRENT_DIR=$(pwd)
AUTHOR="${CONFIG_DEFAULT_AUTHOR:-}"
LICENSE_TYPE="${CONFIG_DEFAULT_LICENSE:-none}"
PYTHON_VERSION=""

# ========================
#   Aide
# ========================
show_help() {
    cat <<EOF
Usage: create_project [options] [project_name]

Frameworks:
  --django              Creer un projet Django
  --fastapi             Creer un projet FastAPI
  --flask               Creer un projet Flask

Options:
  --no-venv             Ne pas creer d'environnement virtuel
  --venv-name <name>    Nom du dossier venv (defaut: .venv)
  --no-git              Ne pas initialiser de depot Git
  --db <type>           Base de donnees : sqlite, postgres, mysql
  --db-name <name>      Nom de la base de donnees
  --db-user <user>      Utilisateur DB
  --db-pass <pass>      Mot de passe DB
  --author <name>       Auteur du projet (pour le README)
  --license <type>      Licence : mit, gpl, apache, none (defaut: none)
  --python-version <v>  Version de Python (ex: 3.12)
  --yes                 Mode non interactif (choix par defaut)
  --config              Ouvrir le fichier de configuration
  --show-config         Afficher la configuration actuelle
  --version             Affiche la version
  --help                Affiche cette aide
EOF
    exit 0
}

show_version() {
    echo "create_project $SYSTEM_UTILITIES_VERSION"
    exit 0
}

# ========================
#   Parse des options
# ========================
while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-venv) CREATE_VENV=false; shift ;;
        --venv-name) VENV_NAME="$2"; shift 2 ;;
        --no-git) INIT_GIT=false; shift ;;
        --django) CREATE_DJANGO=true; shift ;;
        --fastapi) CREATE_FASTAPI=true; shift ;;
        --flask) CREATE_FLASK=true; shift ;;
        --db) DB_CHOICE="$2"; shift 2 ;;
        --db-name) DB_NAME="$2"; shift 2 ;;
        --db-user) DB_USER="$2"; shift 2 ;;
        --db-pass) DB_PASS="$2"; shift 2 ;;
        --author) AUTHOR="$2"; shift 2 ;;
        --license) LICENSE_TYPE="$2"; shift 2 ;;
        --python-version) PYTHON_VERSION="$2"; shift 2 ;;
        --yes) YES_MODE=true; shift ;;
        --config) ${EDITOR:-nano} "$CONFIG_FILE"; exit 0 ;;
        --show-config) show_config; exit 0 ;;
        --version) show_version ;;
        --help) show_help ;;
        *) PROJECT_NAME="$1"; shift ;;
    esac
done

# Verifier qu'un seul framework est selectionne
FRAMEWORK_COUNT=0
$CREATE_DJANGO && FRAMEWORK_COUNT=$((FRAMEWORK_COUNT + 1))
$CREATE_FASTAPI && FRAMEWORK_COUNT=$((FRAMEWORK_COUNT + 1))
$CREATE_FLASK && FRAMEWORK_COUNT=$((FRAMEWORK_COUNT + 1))

if [[ $FRAMEWORK_COUNT -gt 1 ]]; then
    msg_error "Selectionnez un seul framework (--django, --fastapi, --flask)"
    exit 1
fi

# ========================
#   Creation du projet
# ========================

# Verifier Python
ensure_python

# Creer le dossier du projet
if [[ -n "$PROJECT_NAME" ]]; then
    PROJECT_DIR="$CURRENT_DIR/$PROJECT_NAME"
    mkdir -p "$PROJECT_DIR"
    cd "$PROJECT_DIR"
else
    PROJECT_DIR="$CURRENT_DIR"
    PROJECT_NAME=$(basename "$CURRENT_DIR")
fi

msg_info "Creation du projet dans $PROJECT_DIR"

# Environnement virtuel
if $CREATE_VENV; then
    create_venv "$PROJECT_DIR" "$VENV_NAME"
    upgrade_pip "$PROJECT_DIR" "$VENV_NAME"
fi

# Structure du projet
if $CREATE_DJANGO; then
    mkdir -p src
    if $CREATE_VENV; then
        "$PROJECT_DIR/$VENV_NAME/bin/pip" install django python-dotenv dj-database-url django-debug-toolbar --quiet
    fi
    django-admin startproject core src/
    
    # Split des settings Django (base.py, dev.py, prod.py)
    split_django_settings "$PROJECT_DIR"
    
    msg_success "Projet Django initialise."
elif $CREATE_FASTAPI; then
    mkdir -p src/"$PROJECT_NAME" tests docs
    touch src/"$PROJECT_NAME"/__init__.py
    
    if $CREATE_VENV; then
        "$PROJECT_DIR/$VENV_NAME/bin/pip" install fastapi uvicorn python-dotenv pydantic --quiet
    fi
    
    # Creer le fichier principal FastAPI
    create_fastapi_app "$PROJECT_DIR" "$PROJECT_NAME"
    
    msg_success "Projet FastAPI initialise."
elif $CREATE_FLASK; then
    mkdir -p src/"$PROJECT_NAME" tests docs templates static
    touch src/"$PROJECT_NAME"/__init__.py
    
    if $CREATE_VENV; then
        "$PROJECT_DIR/$VENV_NAME/bin/pip" install flask python-dotenv --quiet
    fi
    
    # Creer le fichier principal Flask
    create_flask_app "$PROJECT_DIR" "$PROJECT_NAME"
    
    msg_success "Projet Flask initialise."
else
    mkdir -p src/"$PROJECT_NAME" tests docs
    touch src/"$PROJECT_NAME"/__init__.py
    msg_success "Structure Python generee."
fi

# Base de donnees
setup_database "$PROJECT_NAME" \
    ${YES_MODE:+--yes} \
    ${DB_CHOICE:+--db "$DB_CHOICE"} \
    ${DB_NAME:+--db-name "$DB_NAME"} \
    ${DB_USER:+--db-user "$DB_USER"} \
    ${DB_PASS:+--db-pass "$DB_PASS"}
create_env_file "$PROJECT_DIR"

# Requirements
if $CREATE_DJANGO; then
    cat <<EOF > "$PROJECT_DIR/requirements.txt"
Django>=5,<6
python-dotenv
dj-database-url
django-debug-toolbar>=4.0.0
EOF
elif $CREATE_FASTAPI; then
    cat <<EOF > "$PROJECT_DIR/requirements.txt"
fastapi>=0.100.0
uvicorn[standard]>=0.23.0
python-dotenv>=1.0.0
pydantic>=2.0.0
pydantic-settings>=2.0.0
EOF
elif $CREATE_FLASK; then
    cat <<EOF > "$PROJECT_DIR/requirements.txt"
flask>=3.0.0
python-dotenv>=1.0.0
EOF
else
    cat <<EOF > "$PROJECT_DIR/requirements.txt"
python-dotenv>=1.0.0
EOF
fi

# Git
if $INIT_GIT; then
    init_git "$PROJECT_DIR"
    create_gitignore "$PROJECT_DIR"
fi

# Licence
if [[ "$LICENSE_TYPE" != "none" ]]; then
    generate_license "$PROJECT_DIR" "$LICENSE_TYPE" "$AUTHOR"
fi

# Makefile
cat <<EOF > "$PROJECT_DIR/Makefile"
VENV = $VENV_NAME
PYTHON = $PYTHON_CMD

setup:
	\$(PYTHON) -m venv \$(VENV)
	\$(VENV)/bin/pip install --upgrade pip
	\$(VENV)/bin/pip install -r requirements.txt
EOF

if $CREATE_DJANGO; then
    cat <<EOF >> "$PROJECT_DIR/Makefile"

run:
	\$(VENV)/bin/python src/manage.py runserver

migrate:
	\$(VENV)/bin/python src/manage.py migrate

createsuperuser:
	\$(VENV)/bin/python src/manage.py createsuperuser
EOF
elif $CREATE_FASTAPI; then
    cat <<EOF >> "$PROJECT_DIR/Makefile"

run:
	\$(VENV)/bin/python -m uvicorn src.$PROJECT_NAME.main:app --reload --host 0.0.0.0 --port 8000

dev:
	\$(VENV)/bin/python -m uvicorn src.$PROJECT_NAME.main:app --reload --host 0.0.0.0 --port 8000
EOF
elif $CREATE_FLASK; then
    cat <<EOF >> "$PROJECT_DIR/Makefile"

run:
	\$(VENV)/bin/python run.py

dev:
	\$(VENV)/bin/python run.py
EOF
else
    cat <<EOF >> "$PROJECT_DIR/Makefile"

run:
	\$(VENV)/bin/python -m src.$PROJECT_NAME
EOF
fi

cat <<EOF >> "$PROJECT_DIR/Makefile"

test:
	\$(PYTHON) -m unittest discover tests

lint:
	\$(VENV)/bin/ruff check src/ tests/

format:
	\$(VENV)/bin/ruff format src/ tests/

check:
	\$(VENV)/bin/ruff check src/ tests/
	\$(VENV)/bin/ruff format --check src/ tests/

freeze:
	\$(VENV)/bin/pip freeze > requirements.txt

clean:
	rm -rf __pycache__ *.pyc \$(VENV) .ruff_cache
	find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
EOF

# README
cat <<EOF > "$PROJECT_DIR/README.md"
# $PROJECT_NAME

${AUTHOR:+Auteur : $AUTHOR
}
## Installation

\`\`\`bash
make setup
\`\`\`

## Lancer le serveur

\`\`\`bash
make run
\`\`\`

## Commandes utiles

| Commande | Description |
|---|---|
| \`make setup\` | Installer les dependances |
| \`make run\` | Lancer le serveur |
| \`make migrate\` | Executer les migrations |
| \`make test\` | Lancer les tests |
| \`make lint\` | Verifier le code (ruff) |
| \`make format\` | Formater le code (ruff) |

## Variables d'environnement

Voir fichier \`.env.example\`.
EOF

msg_success "Makefile ajoute."
msg_success "README.md cree."
echo
msg_success "Projet '$PROJECT_NAME' pret dans $PROJECT_DIR"
