#!/bin/bash
# commands/deploy_project — Deploiement de projets Python
# Usage: deploy_project [options] [project_dir]

set -euo pipefail

# ========================
#   Source des librairies
# ========================
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$(cd "$SCRIPT_DIR/../lib" && pwd)"

source "$LIB_DIR/common.sh"

# ========================
#   Configuration
# ========================
DEPLOY_DIR="deploy"
REMOTE_HOST=""
REMOTE_USER=""
REMOTE_PATH=""
BUILD_DOCKER=false
INCLUDE_VENV=false

# ========================
#   Aide
# ========================
show_help() {
    cat <<EOF
Usage: deploy_project [options] [project_dir]

Options:
  --output <dir>       Repertoire de sortie (defaut: deploy/)
  --remote <user@host> Deploier sur un serveur distant (SSH)
  --remote-path <path> Chemin distant sur le serveur
  --docker             Creer un Dockerfile pour le deploiement
  --include-venv       Inclure l'environnement virtuel
  --help               Affiche cette aide
EOF
    exit 0
}

# ========================
#   Parse des options
# ========================
PROJECT_DIR=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --output) DEPLOY_DIR="$2"; shift 2 ;;
        --remote) REMOTE_HOST="$2"; shift 2 ;;
        --remote-path) REMOTE_PATH="$2"; shift 2 ;;
        --docker) BUILD_DOCKER=true; shift ;;
        --include-venv) INCLUDE_VENV=true; shift ;;
        --help) show_help ;;
        *) PROJECT_DIR="$1"; shift ;;
    esac
done

# Dossier par defaut
PROJECT_DIR="${PROJECT_DIR:-.}"

if [[ ! -d "$PROJECT_DIR" ]]; then
    msg_error "Le dossier $PROJECT_DIR n'existe pas."
    exit 1
fi

cd "$PROJECT_DIR" || exit 1
PROJECT_NAME=$(basename "$(pwd)")

# ========================
#   Detection du framework
# ========================
FRAMEWORK="python"

if [[ -f "src/manage.py" ]] || [[ -f "manage.py" ]]; then
    FRAMEWORK="django"
elif [[ -f "src/"*"/main.py" ]]; then
    FRAMEWORK="fastapi"
elif [[ -f "run.py" ]] || [[ -f "src/"*"/__init__.py" ]]; then
    # Verifier si c'est Flask (pas de FastAPI)
    if grep -q "from flask" src/*/*.py 2>/dev/null || grep -q "import Flask" src/*/*.py 2>/dev/null; then
        FRAMEWORK="flask"
    fi
fi

msg_info "Framework detecte : $FRAMEWORK"

# ========================
#   Creation du dossier de deploiement
# ========================
mkdir -p "$DEPLOY_DIR"

# ========================
#   Copie des fichiers
# ========================
msg_progress "Copie des fichiers..."

# Fichiers de base
cp -r src "$DEPLOY_DIR/" 2>/dev/null || true
cp requirements.txt "$DEPLOY_DIR/" 2>/dev/null || true
cp Makefile "$DEPLOY_DIR/" 2>/dev/null || true
cp README.md "$DEPLOY_DIR/" 2>/dev/null || true
cp .env "$DEPLOY_DIR/" 2>/dev/null || true
cp .env.example "$DEPLOY_DIR/" 2>/dev/null || true

# Fichiers specifiques
if [[ -f "manage.py" ]]; then
    cp manage.py "$DEPLOY_DIR/"
fi
if [[ -f "run.py" ]]; then
    cp run.py "$DEPLOY_DIR/"
fi
if [[ -f "wsgi.py" ]]; then
    cp wsgi.py "$DEPLOY_DIR/"
fi
if [[ -f "asgi.py" ]]; then
    cp asgi.py "$DEPLOY_DIR/"
fi

# Inclure le venv si demande
if $INCLUDE_VENV && [[ -d ".venv" ]]; then
    msg_progress "Copie de l'environnement virtuel (peut etre long)..."
    cp -r .venv "$DEPLOY_DIR/"
fi

# ========================
#   Docker (optionnel)
# ========================
if $BUILD_DOCKER; then
    msg_progress "Creation du Dockerfile..."
    
    case $FRAMEWORK in
        django)
            cat <<'DOCKERFILE' > "$DEPLOY_DIR/Dockerfile"
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN python src/manage.py collectstatic --noinput

EXPOSE 8000

CMD ["python", "src/manage.py", "runserver", "0.0.0.0:8000"]
DOCKERFILE
            ;;
        fastapi)
            cat <<'DOCKERFILE' > "$DEPLOY_DIR/Dockerfile"
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
DOCKERFILE
            ;;
        flask)
            cat <<'DOCKERFILE' > "$DEPLOY_DIR/Dockerfile"
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 5000

CMD ["python", "run.py"]
DOCKERFILE
            ;;
        *)
            cat <<'DOCKERFILE' > "$DEPLOY_DIR/Dockerfile"
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

CMD ["python", "-m", "src"]
DOCKERFILE
            ;;
    esac
    
    msg_success "Dockerfile cree."
fi

# ========================
#   Archive
# ========================
msg_progress "Creation de l'archive..."
ARCHIVE="${PROJECT_NAME}-$(date +%Y%m%d-%H%M%S).tar.gz"
tar -czf "$ARCHIVE" -C "$DEPLOY_DIR" .
msg_success "Archive creee : $ARCHIVE"

# ========================
#   Deploiement distant (optionnel)
# ========================
if [[ -n "$REMOTE_HOST" ]]; then
    REMOTE_PATH="${REMOTE_PATH:-/opt/$PROJECT_NAME}"
    
    msg_progress "Deploiement sur $REMOTE_HOST..."
    
    # Copier l'archive
    scp "$ARCHIVE" "${REMOTE_HOST}:/tmp/"
    
    # Deployer sur le serveur distant
    ssh "$REMOTE_HOST" << REMOTE_CMD
        sudo mkdir -p $REMOTE_PATH
        sudo tar -xzf /tmp/$ARCHIVE -C $REMOTE_PATH
        sudo rm /tmp/$ARCHIVE
        cd $REMOTE_PATH
        python3 -m venv .venv 2>/dev/null || true
        .venv/bin/pip install -r requirements.txt
REMOTE_CMD
    
    msg_success "Deploie sur $REMOTE_HOST:$REMOTE_PATH"
fi

# ========================
#   Resume
# ========================
echo
msg_success "Deploiement prepare dans $DEPLOY_DIR/"
msg_info "Archive : $ARCHIVE"
if [[ -n "$REMOTE_HOST" ]]; then
    msg_info "Serveur : $REMOTE_HOST:$REMOTE_PATH"
fi
