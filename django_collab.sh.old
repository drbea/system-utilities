#!/bin/bash

# PROJECT_DIR=${1:-.}  # Dossier courant par défaut
PROJECT_DIR=$(pwd)

cd "$PROJECT_DIR" || exit 1

# Couleurs
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

cleanup() {
    echo -e "\n${RED}🛑 Fermeture port 8000...${NC}"
    sudo firewall-cmd --permanent --remove-port=8000/tcp 2>/dev/null
    sudo firewall-cmd --reload 2>/dev/null
    echo -e "${GREEN}✅ Nettoyé !${NC}"
    exit 0
}

trap cleanup SIGINT

echo -e "${YELLOW}🚀 Django Collab dans $PROJECT_DIR${NC}"

# Migrations
if [ "$(python manage.py showmigrations | grep '\[ \]' | wc -l)" -gt 0 ]; then
    echo -e "${YELLOW}📥 Migrations...${NC}"
    python manage.py makemigrations --dry-run
    python manage.py migrate
fi

# Pare-feu
sudo firewall-cmd --permanent --add-port=8000/tcp 2>/dev/null || true
sudo firewall-cmd --reload

# IP
IP=$(ip route get 8.8.8.8 | awk '{print $7; exit}')
echo -e "${GREEN}🌐 http://$IP:8000${NC}"
echo -e "${GREEN}Ctrl+C pour arrêter${NC}"

python manage.py runserver 0.0.0.0:8000

